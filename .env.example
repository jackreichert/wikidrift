# WikiDrift LLM config — copy to `.env` (gitignored) and fill in.
# Only the layers L2 (stance) and L5 (claim adjudication) use an LLM; everything else is offline.
# You only need the key for the provider you choose. .env is auto-loaded (never overrides an existing env var).

# Provider selection (optional — default is anthropic). Also settable per-run via --provider/--model/--base-url.
# WIKIDRIFT_LLM_PROVIDER=anthropic        # anthropic (default) | openai | google | xai (alias: grok)
# WIKIDRIFT_LLM_MODEL=                     # e.g. gpt-4o-mini, gemini-flash-lite-latest, grok-4 (else the provider default)
# WIKIDRIFT_LLM_BASE_URL=                  # openai-compatible endpoint: OpenRouter/Together/Groq/DeepSeek/xAI; local Ollama/LM Studio/vLLM
#                                          # (xai defaults to https://api.x.ai/v1 — only set this to override)

# Auto-failover priority (used when WIKIDRIFT_LLM_PROVIDER is not explicitly set): first provider with a
# configured key is used; on rate/quota exhaustion, calls fail over to the next provider in this order.
# WIKIDRIFT_LLM_PROVIDER_PRIORITY=anthropic,openai,grok,google
# Optional per-provider model overrides for auto mode:
# WIKIDRIFT_LLM_MODEL_ANTHROPIC=claude-sonnet-5
# WIKIDRIFT_LLM_MODEL_OPENAI=gpt-4o-mini
# WIKIDRIFT_LLM_MODEL_GROK=grok-3-mini
# WIKIDRIFT_LLM_MODEL_GOOGLE=gemini-flash-lite-latest
# Grok uses the OpenAI-compatible client path:
# WIKIDRIFT_LLM_GROK_BASE_URL=https://api.x.ai/v1

# Provider API keys — set only the one you use (WIKIDRIFT_LLM_API_KEY overrides all).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
# WIKIDRIFT_LLM_API_KEY=

# Optional cost estimates. Rates are USD per million tokens and are operator-supplied so reports use
# the prices applicable to your provider/account. Key each rate by provider:model.
# WIKIDRIFT_LLM_PRICING_JSON={"anthropic:claude-sonnet-5":{"input_per_million":0,"output_per_million":0},"openai:gpt-4o-mini":{"input_per_million":0,"output_per_million":0}}
